# No incluir en la imagen del container (más liviana, build más rápido)

# Control de versiones
.git/
.gitignore

# Documentación y archivos de proyecto (no se necesitan en runtime)
docs/
*.md
!armahub/**/*.md

# Python local
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Secretos y entorno local (NUNCA en la imagen)
.env
.env.*

# Tests y scripts de desarrollo
smoke_test.py
run_smoke_test.bat
clean_db.py

# Config de otros hostings
render.yaml
Procfile

# Infra de Cloudflare (no va dentro del container)
wrangler.toml
.wrangler/
node_modules/

# Sistema
.DS_Store
Thumbs.db
